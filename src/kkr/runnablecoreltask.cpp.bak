#include "runnablecoreltask.h"
#include <windows.h>
#include <objbase.h>
#include "kkrprogressdialog.h"
#include "kkrmainwindow.h"

#include <QAxObject>
#include <QThread>
#include <QDir>
#include <QtDebug>
#include <QTemporaryDir>
#include <QApplication>
#include <QtMath>

RunnableCorelTask::RunnableCorelTask(QAbstractItemModel *model)
: taskModel(model), n(), connected(false), duplicateOffsets {}, QRunnable() {
  qreal offsets = 61.297, my, mx;
  
  for(int r=0; r<8; ++r) {
    for(int c=0; c<5; ++c) {
      if(r == 0 && c == 0) continue;
      if(c % 2) {
        duplicateOffsets << QSizeF( c * offsets, (-r * offsets) + 35.867);
        if(r == 7) {
          duplicateOffsets << QSizeF( c * offsets, (-r * offsets) + 35.867 - offsets);          
        }
      } else {
        duplicateOffsets << QSizeF(c * offsets, -r * offsets);
      }
    }
  }

}

bool RunnableCorelTask::connectSignals(QObject *obj) {
  KKRProgressDialog *kkr_pd = qobject_cast<KKRProgressDialog*>(obj);
  if(!kkr_pd) return false;
  n.connect(&n, &Notifier::currentChanged, kkr_pd, &KKRProgressDialog::setCurrent);
  n.connect(&n, &Notifier::maximumChanged, kkr_pd, &KKRProgressDialog::setMaximum);
  n.connect(&n, &Notifier::minimumChanged, kkr_pd, &KKRProgressDialog::setMinimum);
  n.connect(&n, &Notifier::messageChanged, kkr_pd, &KKRProgressDialog::setMessage);
  n.connect(&n, &Notifier::started, kkr_pd, &KKRProgressDialog::onStarted);
  n.connect(&n, &Notifier::canceled, kkr_pd, &KKRProgressDialog::onCanceled);
  n.connect(&n, &Notifier::stopped, kkr_pd, &KKRProgressDialog::onStopped);
  n.connect(&n, &Notifier::error, kkr_pd, &KKRProgressDialog::onError);
  n.connect(kkr_pd, &KKRProgressDialog::requestCancel, &n, &Notifier::cancelRequested);
  connected = true;
  return connected;
}

void RunnableCorelTask::run() {
  QStringList generatedFiles;
  CoInitializeEx(NULL, COINIT_MULTITHREADED);
  emit n.started();
  n.emitMessage("Mencoba menggunakan CorelDRAW V26 (2025) . . .");
  QThread::sleep(3);
  QAxObject ax("CorelDRAW.Application.26");
  QThread::sleep(1);
  if(ax.isNull()) {
    n.emitMessage("Tidak dapat menggunakan CorelDRAW V26 (2025) !!");
    QThread::sleep(1);
    n.emitMessage("Mencoba kembali dengan menggunakan CorelDRAW V22 (2020) . . .");
    QThread::sleep(3);
    ax.setControl("CorelDRAW.Application.22");
    if(ax.isNull()) {
      emit n.error("Tidak dapat menginisiasi CorelDRAW V22(2022) ataupun V26(2025)\n"
                   "Pastikan anda telah menginstall Aplikasi CorelDRAW (V22 / V26)\n"
                   "Jika anda merasa ini adalah kesalahan silahkan hubungi Pengembang.");
      emit n.stopped();
      return;
    }
  }
  n.emitMessage("Inisiasi CorelDRAW berhasil !");
  QThread::sleep(1);
  n.emitMessage("Tunggu sebentar . . .");
  QThread::sleep(1);
  emit n.messageChanged("Memulai !");
  QThread::sleep(1);
  QTemporaryDir tempDir;
  int itemCount = taskModel->rowCount(), 
      failCount = 0;
  n.emitMaximum(itemCount);
  auto sio = ax.querySubObject("CreateStructImportOptions()");
  for(int i=0; i<itemCount; ++i) {
    n.emitCurrent(i);
    QString savedName = tempDir.filePath(QString("pix_%1.png").arg(i, 2, 10, QChar('0')));
    auto modelIndex = taskModel->index(i, 0);
    QPixmap pix = modelIndex.data(KKRMainWindow::FullPixmapRole).value<QPixmap>();
    if(pix.isNull()) {
      ++failCount;
      n.emitMessage("Tidak dapat membaca gambar");
      n.emitMinimum(failCount);
      continue;
    }
    n.emitMessage("Mengextrak gambar. . .");
    pix.save(savedName);
    savedName = QDir::toNativeSeparators(savedName);
    n.emitMessage("Membuat dokumen baru. . .");
    auto doc = ax.querySubObject("CreateDocument()");
    QThread::sleep(1);
    if(!ax.property("Visible").toBool()) {
      ax.setProperty("Visible", true);
    }
    doc->setProperty("Unit", 3);
    doc->setProperty("ReferencePoint", 9);
    doc->setProperty("Name", modelIndex.data(KKRMainWindow::InformationRole).toString());
    auto page = doc->querySubObject("ActivePage");
    page->dynamicCall("SetSize(330, 483)");
    auto layer = page->querySubObject("Layers(\"Layer 1\")");
    n.emitMessage("Menempatkan Gambar . . .");
    layer->dynamicCall("Import(QString, int, QAxObject)", savedName, 0, sio->asVariant());
    auto picShape = layer->querySubObject("Shapes")->querySubObject("First");
    picShape->querySubObject("Bitmap")->dynamicCall("ConvertTo(5)"); // As CMYK Image
    
    QThread::sleep(1);
    
    qreal width = picShape->property("SizeWidth").toDouble(),
          height = picShape->property("SizeHeight").toDouble();
    QSizeF picSize(width, height);
    QString itemText = modelIndex.data(Qt::DisplayRole).toString();
    if(itemText.isEmpty()) {
      picSize.scale(51.0, 51.0, Qt::KeepAspectRatio);
      picShape->dynamicCall("SetSize(qreal, qreal)", picSize.width(), picSize.height());
      picShape->dynamicCall("SetPosition(qreal, qreal)", 42.406, 450.821);
      auto shapeRange = ax.querySubObject("CreateShapeRange()");
      shapeRange->dynamicCall("Add(QAxObject)", picShape->asVariant());
      for(auto off : duplicateOffsets) {
        auto cs = picShape->querySubObject("Duplicate(qreal, qreal)", off.width(), off.height());
        shapeRange->dynamicCall("Add(QAxObject)", cs->asVariant());
      }
      auto pageRect = layer->querySubObject("CreateRectangle(qreal, qreal, qreal, qreal,)", 
          page->property("LeftX"), page->property("TopY"), page->property("RightX"), page->property("BottomY"));
      pageRect->querySubObject("Outline")->dynamicCall("SetNoOutline()");
      auto itemColor = modelIndex.data(KKRMainWindow::ColorDataRole).value<QColor>();
      if(itemColor.spec() == QColor::Cmyk) {
        auto corelColor = ax.querySubObject("CreateCMYKColor(int, int, int, int)",
                              itemColor.cyanF() * 100,
                              itemColor.magentaF() * 100,
                              itemColor.yellowF() * 100,
                              itemColor.blackF() * 100);
        pageRect->querySubObject("Fill")->dynamicCall("ApplyUniformFill(QAxObject)", corelColor->asVariant());
        corelColor->clear();
      } else {
        if(itemColor.spec() != QColor::Rgb) {
          itemColor = itemColor.convertTo(QColor::Rgb);
        }
        auto corelColor = ax.querySubObject("CreateRGBColor(int, int, int)", itemColor.red(), itemColor.green(), itemColor.blue());
        pageRect->querySubObject("Fill")->dynamicCall("ApplyUniformFill(QAxObject)", corelColor->asVariant());
        corelColor->clear();
      }
      pageRect->dynamicCall("OrderToBack()");
      shapeRange->dynamicCall("AddToPowerClip(QAxObject)", pageRect->asVariant());
      shapeRange->clear();
      pageRect->clear();
    } else {  
      picSize.scale(38.0, 38.0, Qt::KeepAspectRatio);
      picShape->dynamicCall("SetSize(qreal, qreal)", picSize.width(), picSize.height());
    /*
          factorA = 0,
          factorB = 0,
          factorS = 0;
    factorA = 37.0 / width;
    factorB = 37.0 / height;
    factorS = qMax(factorA, factorB);
    */
      picShape->dynamicCall("SetPosition(qreal, qreal)", 42.619, 457.858);
      auto outerRect = layer->querySubObject("CreateRectangle(qreal, qreal, qreal, qreal)",
        picShape->property("LeftX").toDouble() - 12.398, 
        picShape->property("TopY").toDouble() + 5.149, 
        picShape->property("RightX").toDouble() + 12.398, 
        picShape->property("BottomY").toDouble() - 19.222 );
    
    
      outerRect->querySubObject("Outline")->dynamicCall("SetNoOutline()");
    /*
      Prototype CreateParagraphText
      
      CreateParagraphText(
        Left As Double, Top As Double, 
        Right As Double, Bottom As Double, 
        [Text As String], [LanguageID As cdrTextLanguage = cdrLanguageNone], 
        [CharSet As cdrTextCharSet = cdrCharSetMixed], 
        [Font As String], [Size As Single], 
        [Bold As cdrTriState = cdrUndefined], 
        [Italic As cdrTriState = cdrUndefined], 
        [Underline As cdrFontLine = cdrMixedFontLine], 
        [Alignment As cdrAlignment = cdrMixedAlignment])
    */
      QList<QVariant> vmap;
      vmap << outerRect->property("LeftX").toDouble() + 3.0; // Left
      vmap << outerRect->property("BottomY").toDouble() + 17.942; // Top
      vmap << outerRect->property("RightX").toDouble() - 3.0 ; // Right
      vmap << outerRect->property("BottomY").toDouble() + 1.097; // Bottom
      vmap << modelIndex.data(Qt::DisplayRole); // Text
      vmap << 0; // LanguageID
      vmap << -1; // CharSet
      vmap << "NF-Le petit cochon"; // Font
      vmap << 15; // Size
      vmap << -2; // Bold
      vmap << -2; // Italic
      vmap << 7; // Underline
      vmap << 3; // Alignment
    
      auto textShape = layer->querySubObject(
        "CreateParagraphText(qreal, qreal, qreal, qreal, const QString&, int, int, "
        "const QString& , int, int, int, int, int)", vmap);
      auto textFill = textShape->querySubObject("Fill")
        ->querySubObject("UniformColor")
        ->dynamicCall("CMYKAssign(0, 0, 0, 0)");

      auto textOutline = textShape->querySubObject("Outline");
      textOutline->querySubObject("Color")->dynamicCall("CMYKAssign(int c, int m, int y, int k)", 80, 40, 40, 100);
      textOutline->setProperty("Width", 1.5471);
      textOutline->setProperty("LineCaps", 1);
      textOutline->setProperty("BehindFill", 1);
      textOutline->setProperty("LineJoin", 1);
    
      auto frame = textShape->querySubObject("Text")->querySubObject("Story")->querySubObject("Frames(1)");
      frame->setProperty("VerticalAlignment", 1 /* CenterJustify */ );
      textShape->querySubObject("Text")->dynamicCall("FitTextToFrame()");
      auto shapeRange = ax.querySubObject("CreateShapeRange()");
      shapeRange->dynamicCall("Add(QAxObject)", picShape->asVariant());
      shapeRange->dynamicCall("Add(QAxObject)", textShape->asVariant());
      shapeRange->dynamicCall("AddToPowerClip(QAxObject)", outerRect->asVariant());
      shapeRange->dynamicCall("RemoveAll()");
    
      picShape->clear();
      textShape->clear();
    
      for(auto ds : duplicateOffsets) {
        auto duplicate = outerRect->querySubObject("Duplicate(qreal, qreal)", ds.width(), ds.height());
      }
    
      shapeRange = layer->querySubObject("Shapes")->querySubObject("All()");
      
      auto pageRect = layer->querySubObject("CreateRectangle(qreal, qreal, qreal, qreal)",
        page->property("LeftX").toDouble(),
        page->property("TopY").toDouble(),
        page->property("RightX").toDouble(),
        page->property("BottomY").toDouble());
      
      shapeRange->dynamicCall("AddToPowerClip(QAxObject)", pageRect->asVariant());
      
      outerRect->clear();
    
      auto itemColor = modelIndex.data(KKRMainWindow::ColorDataRole).value<QColor>();
      if(itemColor.alpha() == 0) {
        pageRect->querySubObject("Fill")->dynamicCall("ApplyNoFill()");
      } else {
        float c1, c2, c3, c4, c5;
        if(itemColor.spec() == QColor::Cmyk) {
          itemColor.getCmykF(&c1, &c2, &c3, &c4, &c5);
          auto cmykColor = ax.querySubObject("CreateCMYKColor(int, int, int, int)", qRound(c1 * 100) , qRound(c2 * 100), qRound(c3 * 100), qRound(c4 * 100));
          pageRect->querySubObject("Fill")->dynamicCall("ApplyUniformFill(QAxObject)", cmykColor->asVariant());
        } else {
          auto conv = itemColor;
          if( conv.spec() != QColor::Rgb ) {
            // convert to rgbColor
            conv = itemColor.convertTo(QColor::Rgb);
          }
          auto rgbColor = ax.querySubObject("CreateRGBColor(int, int, int)", conv.red() , conv.green(), conv.blue());
          pageRect->querySubObject("Fill")->dynamicCall("ApplyUniformFill(QAxObject)", rgbColor->asVariant());
          c5 = itemColor.alphaF();
        }
        if(c5 < 1.0) {
          pageRect->querySubObject("Transparency")->dynamicCall("ApplyUniformTransparency(int)", qRound(c5 * 100));
        }
        pageRect->dynamicCall("OrderToBack()");
        pageRect->querySubObject("Outline")->dynamicCall("SetNoOutline()");
      }
    n.emitCurrent(i+1);
    emit n.singleProcessDone();
    }
  }
  CoUninitialize();
  emit n.stopped();
}